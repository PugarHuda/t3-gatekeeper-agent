# Copy to .env and fill from the T3N token-claim success page.
# NOTE: the API key is shown only once and grants full sandbox access — keep it secret.
T3N_API_KEY=0x...
DID=did:t3n:...

# Web Bot Auth signing key (base64 PKCS#8 Ed25519). Must correspond to the key
# published at <site>/.well-known/http-message-signatures-directory, or no
# destination can verify your signatures. Unset = ephemeral key, warned at runtime.
# Generate: node -e "import('./src/web-bot-auth.mjs').then(m=>{const k=m.generateAgentKey();\
#   console.log(m.exportPrivateKey(k.privateKey), JSON.stringify(m.keyDirectory(k.publicKey,'<did>#wba')))})"
# WBA_PRIVATE_KEY=...

# Optional — credential issuers the mandate trusts (comma-separated DIDs).
# EMPTY MEANS NOT ENFORCED: any issuer passes, including one the agent minted.
# TRUSTED_ISSUERS=did:key:zUC7...,did:key:zUC8...

# Optional — destination of an APPROVED action (step [5] DISPATCH).
# Defaults to the illustrative https://broker.example/v1/orders. Point it at an
# endpoint you control, then run `npm run grant:egress` so the enclave may reach
# its host (outbound HTTP is authorised by the caller's agent-auth grant).
# ACTION_ENDPOINT=https://...
# EGRESS_HOSTS=host1,host2            # defaults to ACTION_ENDPOINT's host

# Optional — the broker credential the ENCLAVE authenticates outbound calls with.
# `npm run setup` seals this into z:<tid>:secrets, a map only the contract can
# read. It is never sent to the agent and cannot be read back out afterwards —
# so set it here, run setup once, then remove it from this file if you like.
# Unset = the mandate's credential_key stays empty and the enclave sends an
# unauthenticated request (which is what the demo endpoint expects).
# BROKER_API_KEY=sk-live-...

# Optional — credential-revocation pre-gate (agent/src/revocation.mjs).
# Leave unset to skip the check (fail-open). Set BOTH to enforce: the agent calls
# @terminal3/revoke_vc isRevoked() against this EVM registry before acting.
# REVOCATION_REGISTRY_ADDRESS=0x...
# REVOCATION_RPC_URL=https://...

# Optional — ERC-8004 on-chain identity (npm run register:erc8004).
# Set all three to mint the agent NFT; the script refuses to run otherwise.
# ERC8004_RPC_URL=https://...
# ERC8004_REGISTRY_ADDRESS=0x...
# ERC8004_PRIVATE_KEY=0x...            # a GAS-FUNDED key (owns the agent NFT)
# AGENT_URI=https://...               # defaults to the hosted agent-card.json

# Optional — x402 payments (agent/src/x402.mjs, and the MCP fetch_paid_resource
# tool). Without a key the agent still reads a 402 and still runs the mandate
# over it; it simply refuses to sign, rather than pretending to pay.
# The key needs the stablecoin, not gas: settlement is gasless for the payer
# (EIP-3009), so the facilitator broadcasts and pays the gas.
# X402_PRIVATE_KEY=0x...              # signs EIP-3009 transfer authorisations
# X402_FACILITATOR_URL=https://x402.org/facilitator   # a real, open facilitator that
#   supports `exact` on eip155:84532. Unset = signatures are made but nothing settles.
#   `npm run x402:verify` proves the signatures are accepted there already.

# Optional — an AGENT key for the node-discovery reads (`npm run discover`).
# NOT the same as T3N_API_KEY above: that one is an Ethereum private key that can
# spend credits and register contracts; this one is scoped and revocable, and is
# what a hosted deployment should carry. The discovery reads accept ONLY this
# form and answer a bare HTTP 400 to the other (bug #24).
#   npx @terminal3/t3n-sdk agent create --org <org-did> --name <name> --env testnet
# The key is printed exactly once.
# T3N_AGENT_KEY=t3n_key_<id>.<secret>
# T3N_AGENT_DID=did:t3n:...
# T3N_ORG_DID=did:t3n:...
