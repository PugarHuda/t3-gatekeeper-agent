    {
      "id": "agent",
      "audio": "audio/agent.mp3",
      "seconds": 15.620000000000001,
      "durationInFrames": 469,
      "captions": [
        {
          "text": "Now the investor delegates buying to an AI agent, and two things break at once.",
          "from": 0,
          "durationInFrames": 153
        },
        {
          "text": "The agent needs their account credentials.",
          "from": 153,
          "durationInFrames": 81
        },
        {
          "text": "And the limits live in the agent's own prompt —",
          "from": 234,
          "durationInFrames": 91
        },
        {
          "text": "which is exactly the thing that cannot be trusted to enforce them.",
          "from": 325,
          "durationInFrames": 128
        }
      ]
    },
    {
      "id": "solution",
      "audio": "audio/solution.mp3",
      "seconds": 17.93,
      "durationInFrames": 538,
      "captions": [
        {
          "text": "Gatekeeper answers both.",
          "from": 0,
          "durationInFrames": 54
        },
        {
          "text": "The fund learns exactly one fact — this buyer is accredited —",
          "from": 54,
          "durationInFrames": 137
